rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isFounderOrAdmin() {
      return isSignedIn() && (getUserData().role == 'founder' || getUserData().role == 'admin');
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can read user profiles
      allow read: if true;
      
      // Users can update their own profile (except for role/rankLabel/appointedBy)
      allow update: if isSignedIn() && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rankLabel', 'appointedBy', 'appointedAt']);
      
      // Admins/Founders can update roles
      allow update: if isFounderOrAdmin();
      
      // Allow users to create their own document on first login
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    // Role Audit Logs
    match /role_audit_logs/{logId} {
      allow read: if isFounderOrAdmin();
      allow create: if isFounderOrAdmin();
    }

    // DMs (Chat)
    match /dms/{convId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      
      match /messages/{msgId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/dms/$(convId)).data.participants;
        allow create: if isSignedIn() 
                      && request.auth.uid == request.resource.data.senderId
                      && request.auth.uid in get(/databases/$(database)/documents/dms/$(convId)).data.participants;
      }
    }

    // News Collection
    match /news/{newsId} {
      allow read: if true;
      allow write: if isFounderOrAdmin();
    }

    // Anime Collection (If applicable)
    match /anime/{animeId} {
      allow read: if true;
      allow write: if isFounderOrAdmin();
    }
    
    // Comments Collection (If applicable)
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isFounderOrAdmin());
    }
  }
}
